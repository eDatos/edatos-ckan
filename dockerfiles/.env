## CAS #########################################################################

# User attributes mapping (required)
# ``email`` and ``user`` mappings are required
#ckanext.cas.user_mapping = email~email fullname~displayName sysadmin~acl 
CKANEXT__CAS__USER_MAPPING=email~email fullname~displayName sysadmin~acl 

# CAS login URL (required)
#ckanext.cas.login_url = https://estadisticas.arte-consultores.com/authentication-service-internal/login 
#ckanext.cas.login_url = https://estadisticas.arte-consultores.com/authentication-service-internal/login
CKANEXT__CAS__LOGIN_URL=https://estadisticas.arte-consultores.com/authentication-service-internal/login

# CAS logout URL (required)
#ckanext.cas.logout_url = https://estadisticas.arte-consultores.com/authentication-service-internal/logout
CKANEXT__CAS__LOGOUT_URL=https://estadisticas.arte-consultores.com/authentication-service-internal/logout

# CKAN application URL (required)
# The URL through which users are interacting with the application
#ckanext.cas.application_url = https://estadisticas.arte-consultores.com/catalogo/ 
CKANEXT__CAS__APPLICATION_URL=https://192.168.10.110:8443/  #https://estadisticas.arte-consultores.com/catalogo/ 

# CAS service validation URL (conditional)
# Either ``ckanext.cas.service_validation_url`` or ``ckanext.cas.saml_validation_url`` must be configured.
#ckanext.cas.service_validation_url = https://estadisticas.arte-consultores.com/authentication-service-internal/p3/serviceValidate
CKANEXT__CAS__SERVICE_VALIDATION_URL=https://estadisticas.arte-consultores.com/authentication-service-internal/p3/serviceValidate

# CAS single sign out (optional)
#ckanext.cas.single_sign_out = true
CKANEXT__CAS__SINGLE_SIGN_OUT=true

# CAS root_path
#ckanext.cas.root_path = /catalogo
CKANEXT__CAS__ROOT_PATH=/

# CAS properties for user login with GobCan CAS (required)
# Admin property
#ckanext.cas.admin_property = ADMINISTRADOR
CKANEXT__CAS__ADMIN_PROPERTY=ADMINISTRADOR

# Member property
#ckanext.cas.member_property = GESTOR
CKANEXT__CAS__MEMBER_PROPERTY= GESTOR 
# Base property 
#ckanext.cas.base_property = CATALOGO_DATOS
CKANEXT__CAS__BASE_PROPERTY=CATALOGO_DATOS

